  volume    = {77},
  number    = {4},
  pages     = {4703--4719},
  year      = {2026},
  publisher = {Elsevier BV},
  abstract  = {This study investigates ZTD prediction using ensemble forecast data from different numerical weather prediction systems. It compares the predictive performance of multiple atmospheric products, evaluates their global and regional differences, and discusses how ensemble information can support more reliable tropospheric delay modeling for high-precision GNSS applications.},

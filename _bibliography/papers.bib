  preview   = {bds-reflectometry.png}
}

@article{hao2025era5-sh,
  title     = {{ERA5-SH}: a global grided scale height dataset for tropospheric parameters based on {ERA5} reanalysis},
  author    = {Hao, Ruixian and Yang, Fei and Li, Zhicai and Zhang, Yuhao and Zhou, Lv and Wang, Lei},
  journal   = {Scientific Data},
  volume    = {12},
  number    = {1},
  year      = {2025},
  publisher = {Springer Science and Business Media LLC},
  abstract  = {ERA5-SH is a global gridded scale-height dataset for tropospheric parameters derived from ERA5 pressure-level reanalysis. The dataset provides scale heights for ZTD, ZHD, ZWD, Tm, PWV, and WVD through profile calculation and exponential fitting, and is validated using radiosonde-derived reference values. It supports GNSS meteorology, tropospheric delay correction, and atmospheric water vapor modeling.},
  doi       = {10.1038/s41597-025-04714-5},
  url       = {https://doi.org/10.1038/s41597-025-04714-5},
  code      = {https://github.com/HaoRuixian/ERA5-SH-dataset-for-troposphere-parameters-code-for-estimate-and-analysis},
  preview   = {era5-sh.png},
  selected  = {true}
}

@article{wen2025tropospheric-delay-products,

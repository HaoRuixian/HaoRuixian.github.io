  volume    = {30},
  number    = {1},
  year      = {2025},
  publisher = {Springer Science and Business Media LLC},
  abstract  = {This paper proposes a parameter-adaptive strategy for GNSS water vapor tomography. By optimizing key tomographic parameters according to observation geometry and atmospheric conditions, the method improves the reconstruction of three-dimensional water vapor fields. The study demonstrates how adaptive parameter design can strengthen GNSS tomography for fine-scale atmospheric water vapor monitoring.},

@article{yang2026gmr-water,
  title     = {{GMR}-water: a water level retrieval software for multi-{GNSS}, multi-frequence and multi-observation based on {GNSS-MR}},
  author    = {Yang, Fei and Hao, Ruixian},
  journal   = {GPS Solutions},
  volume    = {30},
  number    = {3},
  year      = {2026},
  publisher = {Springer Science and Business Media LLC},
  abstract  = {This paper presents GMR-Water, a MATLAB software package for GNSS multipath reflectometry water-level retrieval. The software integrates SNR, carrier-phase, and pseudo-range observations across multiple GNSS constellations and frequencies, and provides a unified workflow for data extraction, inversion, quality control, correction, visualization, and accuracy assessment. The work aims to make high-precision GNSS-MR water-level retrieval more reproducible and accessible for station-scale and network-scale hydrological monitoring.},
  doi       = {10.1007/s10291-026-02111-y},
  url       = {https://doi.org/10.1007/s10291-026-02111-y},
  code      = {https://github.com/HaoRuixian/GNSS-IR-Kit},
  preview   = {gmr-water.png},
  selected  = {true}
}

@article{yang2026ztd-ecmwf,
  title     = {Calculation and evaluation of {ZTD} based on ensemble forecast data and {AI}-based weather model from {ECMWF}},
  author    = {Yang, Fei and Xu, Kaiwen and Hao, Ruixian and Liu, Ruohan and Wang, Lei and Wang, Zhe and Zhou, Dashan},
  journal   = {Geodesy and Geodynamics},
  year      = {2026},
  publisher = {Elsevier BV},
  abstract  = {This study evaluates zenith tropospheric delay estimation from ECMWF ensemble forecast data and AI-based weather model products. By comparing different numerical weather prediction sources and reference observations, the work analyzes the spatial and temporal behavior of ZTD accuracy and discusses the potential of ensemble and AI-driven atmospheric products for GNSS positioning and meteorological applications.},
  doi       = {10.1016/j.geog.2026.06.005},
  url       = {https://doi.org/10.1016/j.geog.2026.06.005},
  preview   = {ztd-ecmwf.png},
  selected  = {true}
}

@article{yang2026gnss-ir-sea-surface-height,
  title     = {A fusion method of {GNSS-IR} sea surface height using the carrier and {SNR}},

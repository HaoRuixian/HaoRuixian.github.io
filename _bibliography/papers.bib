  journal   = {IEEE Journal of Selected Topics in Applied Earth Observations and Remote Sensing},
  volume    = {19},
  pages     = {16732--16742},
  year      = {2026},
  publisher = {Institute of Electrical and Electronics Engineers (IEEE)},
  abstract  = {This paper develops a GNSS-IR sea-surface-height retrieval method that fuses carrier-phase and SNR-derived observations. The proposed Bayesian fusion framework combines complementary retrieval information and observation uncertainties to improve sea-surface-height time series, especially under changing tidal dynamics. The method is designed to enhance the robustness of GNSS reflectometry for coastal sea-level monitoring.},
  doi       = {10.1109/JSTARS.2026.3691785},
  url       = {https://doi.org/10.1109/JSTARS.2026.3691785},
  code      = {https://github.com/HaoRuixian/GNSS-IR-Kit},
  preview   = {gnss-ir-sea-surface.png},
  selected  = {true}
}

@article{xu2026ensemble-ztd,
  title     = {How to predict the zenith tropospheric delay ({ZTD}): using the ensemble forecast data from different {NWP}},
  author    = {Xu, Kaiwen and Yang, Fei and Zhou, Lv and Hao, Ruixian and Wang, Zhuangzhuang and Zhang, Yuhao and Zhu, Yifan},

}

@article{yang2025gnss-parameter-adaptation,
  title     = {An optimal method for {GNSS} water vapor tomography based on parameter adaptation},
  author    = {Yang, Fei and Hao, Ruixian and Wang, Haoyu and Wang, Lei and Li, Zhicai and Zheng, Junxi and Wang, Yingying and Chen, Ran},

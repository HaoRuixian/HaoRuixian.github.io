{% assign media_col_class = 'col-md-6' %}
{% assign body_col_class = 'col-md-6' %}
{% assign image_sizes = '(min-width: 768px) 156px, 50vw' %}
{% if include.wide %}
  {% assign media_col_class = 'col-lg-5' %}
  {% assign body_col_class = 'col-lg-7' %}
  {% assign image_sizes = '(min-width: 992px) 380px, 95vw' %}
{% endif %}

<div class="col mb-3">
  <div class="card h-100 hoverable">
    <div class="row no-gutters project-card-row{% if include.wide %} project-card-row-wide{% endif %}">
      {% if project.img %}
        <div class="{{ media_col_class }} project-card-media">
          <a
            class="project-card-link"
            href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}"
            aria-label="{{ project.title }}"
          >
            {% include figure.liquid loading="eager" path=project.img sizes=image_sizes alt="project thumbnail" class="project-card-img" %}
          </a>
        </div>
      {% endif %}
      <div class="{% if project.img %}{{ body_col_class }}{% else %}col-md-12{% endif %} project-card-copy">
        <div class="card-body">
          <h3 class="card-title">
            <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
              {% if project.title_zh %}
                <span data-lang-en>{{ project.title }}</span>
                <span data-lang-zh>{{ project.title_zh }}</span>
              {% else %}
                {{ project.title }}
              {% endif %}
            </a>
          </h3>
          <p class="card-text">
            <span data-lang-en>{{ project.description }}</span>
            {% if project.description_zh %}
              <span data-lang-zh>{{ project.description_zh }}</span>
            {% endif %}
          </p>
          <div class="row ml-1 mr-1 p-0">
            {% if project.github %}
              <div class="github-icon">
                <div class="icon" data-toggle="tooltip" title="Code Repository">
                  <a href="{{ project.github }}"><i class="fa-brands fa-github gh-icon"></i></a>
                </div>
                {% if project.github_stars %}
                  <span class="stars" data-toggle="tooltip" title="GitHub Stars">
                    <i class="fa-solid fa-star"></i>
                    <span id="{{ project.github_stars }}-stars"></span>
                  </span>
                {% endif %}
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

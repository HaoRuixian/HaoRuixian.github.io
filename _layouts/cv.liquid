---
layout: default
---
{% assign resume = site.data.resume %}

<div class="post cv-page">
  <article class="cv-resume" aria-labelledby="cv-name">
    <header class="cv-resume-header">
      <div class="cv-identity">
        <h1 id="cv-name">
          {{ resume.basics.name }}
          {% if resume.basics.name_zh -%}
            <span>{{ resume.basics.name_zh }}</span>
          {%- endif %}
        </h1>
        <p class="cv-role">{{ resume.basics.label }}</p>
        <p class="cv-affiliation">{{ resume.basics.affiliation }}</p>
      </div>

      <ul class="cv-contact" aria-label="Contact information">
        {% if resume.basics.email %}
          <li>
            <a href="mailto:{{ resume.basics.email }}">{{ resume.basics.email }}</a>
          </li>
        {% endif %}
        {% if resume.basics.url %}
          <li><a href="{{ resume.basics.url }}">haoruixian.github.io</a></li>
        {% endif %}
        {% for profile in resume.basics.profiles %}
          <li>
            <a href="{{ profile.url }}">{{ profile.network }}</a>
          </li>
        {% endfor %}
        {% if resume.basics.location %}
          <li>{{ resume.basics.location.city }}, {{ resume.basics.location.countryCode }}</li>
        {% endif %}
      </ul>

      {% if resume.basics.summary %}
        <p class="cv-summary">{{ resume.basics.summary }}</p>
      {% endif %}
    </header>

    {% if resume.education.size > 0 %}
      <section class="cv-section" aria-labelledby="cv-education">
        <h2 id="cv-education">
          <span data-lang-en>Education</span>
          <span data-lang-zh>教育背景</span>
        </h2>
        <div class="cv-entry-list">
          {% for entry in resume.education %}
            <div class="cv-entry">
              <div class="cv-entry-date">{{ entry.displayDate }}</div>
              <div class="cv-entry-body">
                <h3>{{ entry.studyType }} in {{ entry.area }}</h3>
                <div class="cv-entry-meta">
                  <strong>{{ entry.institution }}</strong>
                  <span>{{ entry.location }}</span>
                </div>
                {% if entry.highlights %}
                  <ul>
                    {% for item in entry.highlights %}
                      <li>{{ item }}</li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      </section>
    {% endif %}

    {% if resume.work.size > 0 %}
      <section class="cv-section" aria-labelledby="cv-research-experience">
        <h2 id="cv-research-experience">
          <span data-lang-en>Research Experience</span>
          <span data-lang-zh>科研经历</span>
        </h2>
        <div class="cv-entry-list">
          {% for entry in resume.work %}
            <div class="cv-entry">
              <div class="cv-entry-date">{{ entry.displayDate }}</div>
              <div class="cv-entry-body">
                <h3>{{ entry.position }}</h3>
                <div class="cv-entry-meta">
                  <strong>{{ entry.name }}</strong>
                  <span>{{ entry.location }}</span>
                </div>
                {% if entry.highlights %}
                  <ul>
                    {% for item in entry.highlights %}
                      <li>{{ item }}</li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      </section>
    {% endif %}

    {% if resume.projects.size > 0 %}
      <section class="cv-section" aria-labelledby="cv-projects">
        <h2 id="cv-projects">
          <span data-lang-en>Selected Research and Open-Source Projects</span>
          <span data-lang-zh>代表性科研与开源项目</span>
        </h2>
        <div class="cv-project-grid">
          {% for entry in resume.projects %}
            <div class="cv-project">
              <h3>
                {% if entry.url -%}
                  <a href="{{ entry.url }}">{{ entry.name }}</a>
                {%- else -%}
                  {{- entry.name -}}
                {%- endif %}
              </h3>
              <p>{{ entry.summary }}</p>
              {% if entry.highlights %}
                <ul>
                  {% for item in entry.highlights %}
                    <li>{{ item }}</li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </section>
    {% endif %}

    {% if resume.publications.size > 0 %}
      <section class="cv-section cv-publications" aria-labelledby="cv-publications">
        <h2 id="cv-publications">
          <span data-lang-en>Selected Publications</span>
          <span data-lang-zh>代表性论文</span>
        </h2>
        <p class="cv-section-note">
          <span data-lang-en>APA style; selected first- and second-author publications. Ruixian Hao is shown in bold.</span>
          <span data-lang-zh>APA 格式；仅列第一、第二作者论文，郝睿贤以粗体标出。</span>
        </p>
        <ol class="cv-publication-list">
          {% for entry in resume.publications %}
            <li>{{ entry.citation | markdownify | remove: '<p>' | remove: '</p>' }}</li>
          {% endfor %}
        </ol>
      </section>
    {% endif %}

    {% if resume.awards.size > 0 %}
      <section class="cv-section" aria-labelledby="cv-awards">
        <h2 id="cv-awards">
          <span data-lang-en>Honors and Awards</span>
          <span data-lang-zh>荣誉奖项</span>
        </h2>
        {% if resume.awards_note %}
          <p class="cv-section-note">{{ resume.awards_note }}</p>
        {% endif %}
        <ul class="cv-award-list">
          {% for entry in resume.awards %}
            <li>
              <span class="cv-award-year">{{ entry.year }}</span>
              <span
                ><strong>{{ entry.title }}</strong>
                {%- if entry.awarder %}, {{ entry.awarder }}{% endif -%}
              </span>
            </li>
          {% endfor %}
        </ul>
      </section>
    {% endif %}

    <div class="cv-bottom-grid">
      {% if resume.skills.size > 0 %}
        <section class="cv-section" aria-labelledby="cv-skills">
          <h2 id="cv-skills">
            <span data-lang-en>Research and Technical Skills</span>
            <span data-lang-zh>研究与技术技能</span>
          </h2>
          <dl class="cv-skill-list">
            {% for entry in resume.skills %}
              <div>
                <dt>{{ entry.name }}</dt>
                <dd>{{ entry.keywords | join: ', ' }}</dd>
              </div>
            {% endfor %}
          </dl>
        </section>
      {% endif %}

      {% if resume.languages.size > 0 %}
        <section class="cv-section" aria-labelledby="cv-languages">
          <h2 id="cv-languages">
            <span data-lang-en>Languages</span>
            <span data-lang-zh>语言能力</span>
          </h2>
          <dl class="cv-language-list">
            {% for entry in resume.languages %}
              <div>
                <dt>{{ entry.language }}</dt>
                <dd>{{ entry.fluency }}</dd>
              </div>
            {% endfor %}
          </dl>
        </section>
      {% endif %}
    </div>
  </article>
</div>
